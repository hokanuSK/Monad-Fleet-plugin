# Copy to .env.aws and fill real values before deploying.

# Global
TZ=UTC
ELAB_NETWORK_SUBNET=172.20.0.0/16

# eLabFTW image + URL
ELAB_WEB_IMAGE=elabftw/elabimg:5.3.11
ELAB_WEB_PORT=9443
ELAB_SITE_URL=https://elab.example.com
ELAB_SERVER_NAME=elab.example.com
ELAB_SECRET_KEY=replace-with-long-random-secret-key

# Optional reverse proxy (Caddy + Let's Encrypt)
# Keep false to use direct ports only.
ENABLE_REVERSE_PROXY=false
ACME_EMAIL=ops@example.com
ELAB_HOST=elab.example.com
GRAFANA_HOST=grafana.example.com
MIMIR_HOST=mimir.example.com
FLEET_METRICS_HOST=metrics.example.com
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# MySQL
MYSQL_ROOT_PASSWORD=replace-root-password
MYSQL_DATABASE=elabftw
MYSQL_USER=elabftw
MYSQL_PASSWORD=replace-db-password

# Fleet service
ELAB_API_KEY=replace-elab-rest-api-key
INGEST_API_TOKEN=
SCAN_CIDR=172.20.0.0/16
FLEET_EXPERIMENT_TAG=fleet
RESOURCE_TAG_PREFIX=device:
POLICY_METADATA_KEYS=fleet.policy,policy,fleet_policy,policy_json
ALLOW_LIVE_EVENTS=false
EVENT_DURATION_MINUTES=180
BOOK_MAX_MINUTES=180
BOOK_CAN_OVERLAP=true
BOOK_IS_CANCELLABLE=true
METRICS_EXCLUDE_PREFIXES=csi_
FLEET_GRPC_PORT=50060
FLEET_METRICS_PORT=9108

# Device simulator
MODEL_DEVICE_MAC=02:42:ac:14:00:04
MODEL_DEVICE_TYPE=rpi-dualband
MODEL_DEVICE_MAX_SYNC_CYCLES=0
MODEL_DEVICE_EXECUTE_POLICY=false

# Observability
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-grafana-password
GRAFANA_PORT=3000
MIMIR_PORT=9009

# First admin bootstrap (used by scripts/aws/elabftw_bootstrap_admin.sh)
ELAB_ADMIN_EMAIL=admin@example.com
ELAB_ADMIN_FIRSTNAME=Admin
ELAB_ADMIN_LASTNAME=User
ELAB_ADMIN_PASSWORD=replace-initial-admin-password
# Keep without spaces (the deploy scripts source this file in shell).
ELAB_TEAM_NAME=MainTeam
