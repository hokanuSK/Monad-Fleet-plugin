%% NOTE: Keep this diagram updated with any protocol or flow changes!
%% Last updated: 2026-03-27
sequenceDiagram
    title: Process B - Detailed Execution + Maintenance Runtime
    autonumber
    box Device Agent
        participant Agent as Agent v2
    end
    box Command Runner
        participant CmdExec as Command Runner
    end
    box Upload Worker
        participant Uploader as Upload Worker
    end
    box Local TSDB
        participant LocalTSDB as Local TSDB
    end
    box Local Run Store
        participant RunStore as Local Run Store
    end
    box Fleet
        participant Fleet as Fleet Manager
    end
    box eLabFTW
        participant ELab as eLabFTW
    end
    box Metrics Backend
        participant Mimir as Mimir
    end
    Note over Agent,Mimir: Derived diagram. Source of truth: lifecycle-v2-normalized.mmd

    rect rgb(227,242,253)
        Note over Agent,Fleet: EXECUTION
        Agent->>Agent: Parse policy_json.command_groups
        loop each execution command
            Agent->>CmdExec: Dispatch next command\nfrom policy
            alt command = hello
                rect rgb(220,252,231)
                    CmdExec->>RunStore: Append HELLO ping event
                    Agent->>Fleet: ReportCommandStatus(hello STARTED/FINISHED)
                    Fleet->>ELab: PATCH /event/{run_event_id} metadata(command_state,last_command,hello_ping)
                end
            else command = upload
                rect rgb(224,242,254)
                    CmdExec->>RunStore: Stage maintenance window + upload params
                    CmdExec->>Mimir: Probe Mimir connectivity (health/ping)
                    alt Mimir reachable
                        Mimir-->>CmdExec: reachable
                        Agent->>Fleet: ReportCommandStatus(upload STARTED/FINISHED, mimir=UP)
                    else Mimir unreachable
                        Mimir-->>CmdExec: timeout/err
                        Agent->>Fleet: ReportCommandStatus(upload STARTED/FINISHED, mimir=DOWN)
                    end
                    Fleet->>ELab: PATCH /event/{run_event_id} metadata(command_state,last_command,upload_window,upload_flags,mimir_connectivity,last_mimir_check_at)
                end
            else command = LogMetrics
                rect rgb(254,249,195)
                    CmdExec->>CmdExec: Run LogMetrics command
                    loop async LogMetrics sampling
                        CmdExec-)LocalTSDB: Collect/store metrics snapshots
                    end
                    CmdExec->>RunStore: Append LogMetrics outputs
                    Agent->>Fleet: ReportCommandStatus(LogMetrics STARTED/FINISHED/FAILED)
                    Fleet->>ELab: PATCH /event/{run_event_id} metadata(command_state,last_command,last_exit_code)
                end
            else command = LogLogs
                rect rgb(237,233,254)
                    CmdExec->>CmdExec: Run LogLogs command
                    loop async LogLogs sampling
                        CmdExec-)RunStore: Collect/store log snapshots
                    end
                    CmdExec->>RunStore: Append LogLogs outputs
                    Agent->>Fleet: ReportCommandStatus(LogLogs STARTED/FINISHED/FAILED)
                    Fleet->>ELab: PATCH /event/{run_event_id} metadata(command_state,last_command,last_exit_code)
                end
            else command = measure (WIFI/BLE/CSI)
                rect rgb(255,237,213)
                    CmdExec->>CmdExec: Configure measurement mode
                    loop async Measurements sampling
                        CmdExec-)RunStore: Save measurement artifacts for MAINTENANCE
                    end
                    Agent->>Fleet: ReportCommandStatus(measure STARTED/FINISHED/FAILED)
                    Fleet->>ELab: PATCH /event/{run_event_id} metadata(command_state,last_command,last_measure_type,last_exit_code)
                end
            else command = ExecuteShell
                rect rgb(226,232,240)
                    CmdExec->>RunStore: Record stdout/stderr/exit_code
                    Agent->>Fleet: ReportCommandStatus(ExecuteShell STARTED/FINISHED/FAILED)
                    Fleet->>ELab: PATCH /event/{run_event_id} metadata(command_state,last_command,last_exit_code)
                end
            end
            Fleet->>Fleet: Map command status to event metadata
            Fleet->>ELab: PATCH /event/{run_event_id} metadata(command_state,last_command,last_exit_code)
        end
    end

    rect rgb(255,243,224)
        Note over Agent,Fleet: MAINTENANCE
        Agent->>Agent: Check maintenance_window(from/to) + slot+jitter
        Agent->>Agent: Set cron wake-up to check maintenance_window + slot+jitter again
        loop while maintenance window+slot is still open
            Agent->>Uploader: Drain queued uploads\nusing staged upload params
            Uploader->>RunStore: Read staged upload params
            Uploader->>RunStore: Check pending upload queues
            alt no pending upload data
                Uploader->>Uploader: Skip upload for this maintenance tick
            else pending upload data
                alt pending metrics/logs
                    Uploader->>LocalTSDB: Read pending metrics/logs batch
                    Uploader->>Mimir: Upload pending metrics + logs
                    Mimir-->>Uploader: metrics/logs ACK/err
                    Uploader->>Fleet: Report metrics/logs upload status
                    Fleet->>ELab: PATCH /event/{run_event_id} metadata(metrics_upload_state,logs_upload_state)
                else no pending metrics/logs
                    Uploader->>Uploader: Skip metrics/logs upload
                end
                alt pending artifacts
                    Uploader->>RunStore: Read next artifact
                    Uploader->>Fleet: Upload artifact from local spool
                    Fleet-->>Uploader: artifact ACK/err
                    Uploader->>Fleet: Report artifact upload status
                    Fleet->>ELab: PATCH /event/{run_event_id} metadata(artifacts_upload_state,last_uploaded_artifact,last_upload_run_id)
                else no pending artifacts
                    Uploader->>Uploader: Skip artifacts upload
                end
                Uploader->>Fleet: PublishReport(report with run_id)
                Fleet->>Fleet: Map upload/report status
                Fleet->>ELab: PATCH /items/{id} metadata(last_report.upload_state,last_report.run_id)
                Fleet-->>Uploader: report upload ACK/err
                alt report upload ACK
                    Uploader->>RunStore: Mark run local state = sent
                else report upload err
                    Uploader->>RunStore: Keep run pending for next maintenance tick
                end
            end
            Agent->>Agent: Check maintenance_window(from/to) + slot+jitter
        end
    end

    Note over Agent: No data-loss path. Unsent runs stay local until a later maintenance window
