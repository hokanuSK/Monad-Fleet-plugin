%% NOTE: Keep this diagram updated with any protocol or flow changes!
%% Last updated: 2026-03-18
sequenceDiagram
    title: Process B - Report Publishing and Event Management
    autonumber
    box Device Agent
        participant Agent as Device
        participant Spool as pending/sent spool
    end
    box Fleet Service
        participant Fleet as Monad Fleet Service
        participant State as state.json
    end
    box eLabFTW
        participant Event as /events/{item}
    end
    box Observability
        participant Metrics as /metrics + ingest
    end

    Agent->>Spool: Execute policy command groups\nand persist run bundle
    Agent->>Fleet: PublishReport(agent_id, report)\n(run_id, events[], artifacts[], summary_metrics)
    Fleet->>State: report_key = run_id|agent_id|policy_id

    alt report duplicate
        State-->>Fleet: already accepted
        Fleet-->>Agent: PublishReportResponse(DUPLICATE)
        Agent->>Spool: Move run to sent/
    else new report
        State-->>Fleet: continue ingest
        loop each report event (or synthetic RUN_FINISHED)
            Fleet->>State: event_id dedupe check
            Fleet->>Event: create or update run event metadata
        end
        loop each report artifact
            Fleet->>Event: ingest ARTIFACT_UPLOADED bridge event
        end
        Fleet->>State: mark report accepted
        Fleet->>Metrics: ingest numeric metrics\n(report + event metric maps)
        Fleet-->>Agent: PublishReportResponse(ACCEPTED)
        Agent->>Spool: Move run pending/ -> sent/
    end

    opt optional live streaming (disabled by default)
        Agent->>Fleet: PublishEvents(agent_id, events[])
        Fleet-->>Agent: EventAck(REJECTED: live events disabled)\nor ACCEPTED when enabled
    end
