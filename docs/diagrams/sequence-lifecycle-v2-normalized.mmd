%% NOTE: Keep this diagram updated with any protocol or flow changes!
%% Last updated: 2026-04-22
sequenceDiagram
    title: Fleet v2 Lifecycle with Execution + Maintenance Windows
    autonumber

    box Device Agent
        participant Agent as Agent v2
        participant CmdExec as Command Runner
        participant Uploader as Upload Worker
        participant LocalTSDB as Local TSDB
        participant RunStore as Local Run Store
    end
    box Backend Services
        participant Fleet as Fleet Manager
        participant ELab as eLabFTW
        participant Mimir as Mimir
    end
    Note over Agent,Mimir: Canonical runtime source of truth for active diagrams

    rect rgb(232,245,233)
        Note over Agent,Mimir: PREPARE
        Agent->>Fleet: GetPolicy(agent_id, last_policy_id)
        Fleet->>ELab: GET /items?search=agent_id
        alt resource item missing
            Fleet->>ELab: POST /items (create device resource)
        end
        Fleet->>ELab: PATCH /items/{id} metadata(<br/>last_seen, interfaces, mode,<br/>fleet_v2_runtime.device_state=ONLINE)
        Fleet->>ELab: GET /experiments?tags[]=fleet
        Fleet->>Fleet: Apply tags + selectors + time-window filtering
        Fleet->>Fleet: Select experiment_id + policy_id

        alt status = OK
            Fleet-->>Agent: GetPolicyResponse(OK + policy_json from selected experiment metadata)
            Fleet->>ELab: PATCH /items/{id} metadata(state=POLICY_SENT, policy_id)
        else status = NOT_MODIFIED
            Fleet->>ELab: PATCH /items/{id} metadata(state=POLICY_CACHED)
            Fleet-->>Agent: GetPolicyResponse(NOT_MODIFIED)
        else status = NO_WORK
            Fleet->>ELab: PATCH /items/{id} metadata(state=IDLE)
            Fleet-->>Agent: GetPolicyResponse(NO_WORK)
        end
    end

    rect rgb(227,242,253)
        Note over Agent,Mimir: EXECUTION
        Note over Agent,Mimir: High-level view of Process B
        Agent->>Agent: Parse policy_json.command_groups
        loop each command from policy JSON
            alt command = SYNC
                rect rgb(255,228,230)
                    CmdExec->>RunStore: Stage maintenance window + slot/jitter policy
                    Agent->>Fleet: ReportCommandStatus(COMMAND_STARTED/FINISHED, command_type=SYNC)
                    Fleet->>ELab: PATCH /event/{run_event_id} metadata:<br/>SYNC window/slot policy
                end
            else command = OBSERVE
                rect rgb(254,249,195)
                    CmdExec->>CmdExec: Apply observability sinks + remote_write settings
                    CmdExec->>Mimir: Probe Mimir metrics path
                    Agent->>Fleet: ReportCommandStatus(<br/>COMMAND_STARTED/FINISHED/FAILED,<br/>command_type=OBSERVE)
                    Fleet->>ELab: PATCH /event/{run_event_id} metadata:<br/>command state + last exit
                end
            else command = WIFI_SCAN
                rect rgb(220,252,231)
                    CmdExec->>CmdExec: Run WIFI_SCAN with RF setup env
                    CmdExec->>RunStore: Persist WiFi outputs + RF context metrics
                    CmdExec-)Mimir: Emit numeric observability metrics
                    Agent->>Fleet: ReportCommandStatus(<br/>COMMAND_STARTED/FINISHED/FAILED,<br/>command_type=WIFI_SCAN, measure_type=WIFI)
                    Fleet->>ELab: PATCH /event/{run_event_id} metadata:<br/>WIFI command state + RF context
                end
            else command = BLE_SCAN
                rect rgb(237,233,254)
                    CmdExec->>CmdExec: Run BLE_SCAN with RF setup env
                    CmdExec->>RunStore: Persist BLE outputs + RF context metrics
                    CmdExec-)Mimir: Emit numeric observability metrics
                    Agent->>Fleet: ReportCommandStatus(<br/>COMMAND_STARTED/FINISHED/FAILED,<br/>command_type=BLE_SCAN, measure_type=BLE)
                    Fleet->>ELab: PATCH /event/{run_event_id} metadata:<br/>BLE command state + RF context
                end
            else command = CAPTURE_CSI
                rect rgb(255,237,213)
                    CmdExec->>CmdExec: Run CAPTURE_CSI with RF setup env
                    CmdExec->>RunStore: Save CSI outputs/evidence + RF context metrics
                    CmdExec-)Mimir: Emit numeric observability metrics
                    Agent->>Fleet: ReportCommandStatus(<br/>COMMAND_STARTED/FINISHED/FAILED,<br/>command_type=CAPTURE_CSI, measure_type=CSI)
                    Fleet->>ELab: PATCH /event/{run_event_id} metadata:<br/>CSI command state + evidence
                end
            else command = SHELL
                rect rgb(226,232,240)
                    CmdExec->>RunStore: Record stdout/stderr/exit_code
                    Agent->>Fleet: ReportCommandStatus(<br/>COMMAND_STARTED/FINISHED/FAILED,<br/>command_type=SHELL)
                    Fleet->>ELab: PATCH /event/{run_event_id} metadata:<br/>command state + last exit
                end
            end
            Agent->>Agent: Dispatch next command from policy
        end
    end

    rect rgb(255,243,224)
        Note over Agent,Mimir: MAINTENANCE
        Agent->>Uploader: Check maintenance window + slot/jitter
        alt outside maintenance window/slot
            Uploader->>RunStore: Keep runs in pending spool
            Agent-)Uploader: Set cron wake-up to re-check<br/>maintenance window + slot/jitter
        else inside maintenance window+slot
            Agent-)Uploader: Set cron wake-up to re-check<br/>maintenance window + slot/jitter
            loop while window+slot is open
                Uploader->>RunStore: Read staged upload params
                Uploader->>RunStore: Check pending upload queues<br/>(metrics/logs, artifacts)
                alt no pending upload data
                    Uploader->>Uploader: Skip upload for this maintenance tick
                else pending upload data
                    alt pending metrics/logs
                        Uploader->>LocalTSDB: Read pending metrics/logs batch
                        Uploader->>Mimir: Upload pending metrics + logs from local TSDB
                        Mimir-->>Uploader: metrics/logs upload ACK/err
                        Uploader->>Fleet: ReportUploadStatus(metrics/logs ACK/err)
                        Fleet->>ELab: PATCH /event/{run_event_id} metadata:<br/>metrics/logs upload state
                    else no pending metrics/logs
                        Uploader->>Uploader: Skip metrics/logs upload
                    end
                    alt pending artifacts
                        Uploader->>RunStore: Read next artifact
                        Uploader->>Fleet: Upload artifact from local spool
                        Fleet-->>Uploader: artifact ACK/err
                        Uploader->>Fleet: ReportArtifactUploadStatus(artifact_id, ACK/err)
                        Fleet->>ELab: PATCH /event/{run_event_id} metadata:<br/>artifacts state + last uploaded ptr
                    else no pending artifacts
                        Uploader->>Uploader: Skip artifacts upload
                    end
                    Uploader->>Fleet: PublishReport(report with run_id)
                    Fleet->>Fleet: Map upload/report status
                    Fleet->>ELab: PATCH /items/{id} metadata:<br/>last report upload state + run_id
                    alt ACCEPTED path
                        Fleet-->>Uploader: ACCEPTED
                        Uploader->>RunStore: Mark run local state = sent
                    else DUPLICATE path
                        Fleet-->>Uploader: DUPLICATE
                        Uploader->>RunStore: Mark run local state = sent
                    else RPC fail
                        Fleet-->>Uploader: RPC error/timeout
                        Uploader->>RunStore: Keep run local state = pending
                    end
                end
                Uploader->>Uploader: Check maintenance window + slot/jitter
            end
        end
    end
