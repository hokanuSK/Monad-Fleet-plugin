%% NOTE: Keep this diagram updated with any protocol or flow changes!
%% Last updated: 2026-03-18
sequenceDiagram
    title: Process A - Experiment Creation/Update and Event Generation
    autonumber
    box Researcher
        actor Researcher
    end
    box eLabFTW
        participant GUI as Web GUI
        participant API as eLabFTW API
    end
    box Fleet Service
        participant Fleet as Monad Fleet Service
    end
    box Device Agent
        participant Agent as Device
        participant Local as Local Policy Cache
    end

    Researcher->>GUI: Create or update experiment
    GUI->>API: POST/PATCH /experiments/{id}
    GUI->>API: PATCH /experiments/{id}\nmetadata.policy (JSON editor)
    GUI->>API: POST /experiments/{id}/tags\n(fleet, device:...)
    API-->>GUI: 200/201 OK

    Agent->>Fleet: Hello(AgentDescriptor)
    Fleet->>API: GET /items?search=agent_id
    alt item missing
        Fleet->>API: POST /items (agent_id, metadata)
    else item exists
        Fleet->>API: PATCH /items/{id} metadata\n(last_seen, interfaces, mode)
    end
    Fleet-->>Agent: HelloResponse(allowed_mode,\nrecommended_prepare_poll_sec, server_time)

    Agent->>Fleet: GetAssignment(agent_id)
    Fleet->>API: GET /experiments?tags[]=fleet
    Note over Fleet: Match experiment by tags + selector + time window
    Fleet-->>Agent: ASSIGNED(experiment_id, policy_id)\nor NO_WORK

    alt ASSIGNED
        Agent->>Fleet: GetPolicy(agent_id, experiment_id,\nlast_policy_id)
        Fleet-->>Agent: GetPolicyResponse(OK/NOT_MODIFIED/NO_POLICY)
        alt status = OK
            Agent->>Local: Store policy(policy_id)
            Agent->>Fleet: AckPrepared(agent_id, experiment_id,\npolicy_id, preparation_id, mode, route_verified)
            Fleet-->>Agent: AckPreparedResponse(ACCEPTED/REJECTED)
        else status = NOT_MODIFIED
            Agent->>Local: Reuse cached policy
        end
    else NO_WORK
        Agent->>Agent: Sleep(recommended_prepare_poll_sec)
    end
