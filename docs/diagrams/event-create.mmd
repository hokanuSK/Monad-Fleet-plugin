%% NOTE: Keep this diagram updated with any protocol or flow changes!
%% Last updated: 2026-03-18
sequenceDiagram
    title: Event Creation Flow
    autonumber
    box Device Agent
        participant Agent as Device
    end
    box Fleet Service
        participant Fleet as Monad Fleet Service
        participant State as state.json
    end
    box eLabFTW
        participant API as /events/{item}
    end

    Agent->>Fleet: PublishReport(report with first run events)
    Fleet->>State: check report_key dedupe\n(run_id|agent_id|policy_id)
    State-->>Fleet: report is new
    Fleet->>State: lookup run_key\n(experiment_id|policy_id|agent_id)
    State-->>Fleet: no run event id mapped
    Fleet->>API: POST /events/{item}\n(title, start, end, metadata)
    API-->>Fleet: 201 Created (event/{id})
    Fleet->>API: PATCH metadata with first bridged event\n(events[], last_event, summary, status)
    API-->>Fleet: 200 OK
    Fleet->>State: store run_key -> event_id + status
    Fleet->>State: mark report_key accepted
    Fleet-->>Agent: PublishReportResponse(ACCEPTED)
