%% NOTE: Keep this diagram updated with any protocol or flow changes!
%% Last updated: 2026-03-18
sequenceDiagram
    title: Event Update Flow
    autonumber
    box Device Agent
        participant Agent as Device
    end
    box Fleet Service
        participant Fleet as Monad Fleet Service
        participant State as state.json
    end
    box eLabFTW
        participant Event as /event/{id}
    end

    Agent->>Fleet: PublishReport(next event batch)\nor PublishEvents (when enabled)
    Fleet->>State: resolve run_key -> event/{id}
    State-->>Fleet: existing event id found
    Fleet->>Event: GET /event/{id}
    Event-->>Fleet: current metadata
    Fleet->>Event: PATCH metadata\n(events[], last_event, summary, status)
    Event-->>Fleet: 200 + updated event
    Fleet->>State: update merged status

    opt terminal state
        Fleet->>Event: set completed_at
    end
    Fleet-->>Agent: ACCEPTED / DUPLICATE / per-event ack
