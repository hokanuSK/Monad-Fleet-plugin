    classDef build fill:#fff8e1,stroke:#ef6c00,stroke-width:1px,color:#e65100
    classDef runtime fill:#fce4ec,stroke:#ad1457,stroke-width:1px,color:#880e4f
    classDef users fill:#f3e5f5,stroke:#6a1b9a,stroke-width:1px,color:#4a148c

    class RootReadme,Map nav
    class Spec,Ops,Research,MMD canon
    class SVG,PDF build
    class Smoke,OpsJSON,Notion runtime
