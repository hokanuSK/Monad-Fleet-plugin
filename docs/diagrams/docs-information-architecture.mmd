flowchart TB
    subgraph Nav["Navigation Layer"]
        RootReadme["README.md<br/>entry point + build commands"]
        Map["DOCS_MAP.md<br/>inventory + read order"]
    end

    subgraph Canon["Canonical Content Layer"]
        Spec["specs/monad_fleet_grpc_interface_v2.tex<br/>protocol source of truth"]
        Ops["ops/*.md<br/>playbooks + handoffs + workflow"]
        Research["research/*.tex<br/>analysis drafts"]
        MMD["diagrams/*.mmd<br/>diagram source of truth"]
    end

    subgraph Build["Build / Render Layer"]
        SVG["diagrams/svg/*.svg<br/>rendered assets"]
        PDF["spec PDF output<br/>from specs/*.tex"]
    end

    subgraph Runtime["Runtime Evidence Layer"]
        Smoke["scripts/smoke/* results"]
        OpsJSON["artifacts/output/ops/*.json fallback"]
        Notion["Notion Ops DB (runs/incidents/tasks/decisions)"]
    end

    subgraph Consumers["Consumer Layer"]
        Integrator["Agent/Service integrator"]
        Operator["Ops / Pi operator"]
        Reviewer["Research / architecture reviewer"]
    end

    RootReadme --> Spec
    RootReadme --> Ops
    RootReadme --> Research
    RootReadme --> MMD
    Map --> Spec
    Map --> Ops
    Map --> Research
    Map --> MMD

    MMD --> SVG
    SVG --> Spec
    Spec --> PDF

    Smoke --> OpsJSON
    Smoke --> Notion
    OpsJSON --> Ops
    Notion --> Ops

    Spec --> Integrator
    Ops --> Operator
    Research --> Reviewer
    SVG --> Integrator
    SVG --> Operator

