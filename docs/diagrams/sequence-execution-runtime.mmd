%% NOTE: Keep this diagram updated with any protocol or flow changes!
%% Last updated: 2026-04-22
sequenceDiagram
    title: Process B1 - Detailed Execution Runtime
    autonumber
    box Device Agent
        participant Agent as Agent v2
        participant CmdExec as Command Runner
        participant LocalTSDB as Local TSDB
        participant RunStore as Local Run Store
    end
    box Backend Services
        participant Fleet as Fleet Manager
        participant ELab as eLabFTW
        participant Mimir as Mimir
    end
    Note over Agent,Mimir: Derived diagram. Source of truth: sequence-lifecycle-v2-normalized.mmd

    rect rgb(227,242,253)
        Note over Agent,Mimir: EXECUTION
        Agent->>Agent: Parse policy_json.command_groups
        loop each execution command
            alt command = SYNC
                rect rgb(255,228,230)
                    CmdExec->>RunStore: Stage maintenance window + slot/jitter policy
                    Agent->>Fleet: ReportCommandStatus(SYNC STARTED/FINISHED)
                    Fleet->>ELab: PATCH /event/{run_event_id} metadata: SYNC window/slot policy state
                end
            else command = OBSERVE
                rect rgb(254,249,195)
                    CmdExec->>CmdExec: Apply OBSERVE sinks + remote_write settings
                    CmdExec->>Mimir: Probe Mimir metrics path
                    Agent->>Fleet: ReportCommandStatus(OBSERVE STARTED/FINISHED/FAILED)
                    Fleet->>ELab: PATCH /event/{run_event_id} metadata: command state + last exit
                end
            else command = WIFI_SCAN
                rect rgb(220,252,231)
                    CmdExec->>CmdExec: Run WIFI_SCAN with RF setup env
                    CmdExec->>RunStore: Persist WiFi outputs + RF context metrics
                    CmdExec-)Mimir: Forward numeric metrics through configured sink path
                    Agent->>Fleet: ReportCommandStatus(WIFI_SCAN STARTED/FINISHED/FAILED)
                    Fleet->>ELab: PATCH /event/{run_event_id} metadata: WIFI_SCAN command state
                end
            else command = BLE_SCAN
                rect rgb(237,233,254)
                    CmdExec->>CmdExec: Run BLE_SCAN with RF setup env
                    CmdExec->>RunStore: Persist BLE outputs + RF context metrics
                    CmdExec-)Mimir: Forward numeric metrics through configured sink path
                    Agent->>Fleet: ReportCommandStatus(BLE_SCAN STARTED/FINISHED/FAILED)
                    Fleet->>ELab: PATCH /event/{run_event_id} metadata: command state + last exit
                end
            else command = CAPTURE_CSI
                rect rgb(255,237,213)
                    CmdExec->>CmdExec: Run CAPTURE_CSI with RF setup env
                    CmdExec->>RunStore: Persist CSI outputs/evidence + RF context metrics
                    CmdExec-)Mimir: Forward numeric metrics through configured sink path
                    Agent->>Fleet: ReportCommandStatus(CAPTURE_CSI STARTED/FINISHED/FAILED)
                    Fleet->>ELab: PATCH /event/{run_event_id} metadata: CAPTURE_CSI state + evidence status
                end
            else command = SHELL
                rect rgb(226,232,240)
                    CmdExec->>RunStore: Record stdout/stderr/exit_code
                    Agent->>Fleet: ReportCommandStatus(SHELL STARTED/FINISHED/FAILED)
                    Fleet->>ELab: PATCH /event/{run_event_id} metadata: command state + last exit
                end
            end
            Fleet->>Fleet: Map command status to event metadata
            Fleet->>ELab: PATCH /event/{run_event_id} metadata: command state projection
            Agent->>Agent: Dispatch next command from policy
        end
    end
