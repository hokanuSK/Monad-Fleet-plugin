# Copy this file to .env and adjust only what you need.
# The Makefile loads .env automatically.

# eLabFTW REST API key used by Fleet service and elab-mcp.
ELAB_API_KEY=apiKey4Test

# Smoke defaults
DO_BUILD=false
RESET_STATE=true
RESET_METRICS=true
RESET_GRAFANA=false
CLEANUP=false
RUN_PI=false
PI_HOST=monad-rpi5.local
SMOKE_PROFILE=full
REAL_DATA_ENFORCE=false
TARGET_DEVICE_IDS_CSV=

# Notion ops sync (optional)
NOTION_SYNC=false
NOTION_SYNC_STRICT=false
NOTION_API_TOKEN=
NOTION_RUNS_DB_ID=8dc731920bf34966bb711472100c7057
NOTION_INCIDENTS_DB_ID=da72692b8106430bb1e3892866d41d20
NOTION_TASKS_DB_ID=4a5936bb0baa4614bb61bc8daed18cee
