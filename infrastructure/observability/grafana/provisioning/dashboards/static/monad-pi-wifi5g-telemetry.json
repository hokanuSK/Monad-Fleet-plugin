{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "5 GHz Wi-Fi monitor-mode telemetry from the agent /metrics endpoint. Shows capture windows, current dwell channel, and channel-hop rate. Sourced from Pi-side Prometheus scraping the agent on each Pi and remote-writing to Mimir.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Capture active right now",
      "description": "1 = tcpdump monitor-mode capture is running on this Pi, 0 = idle. Use to annotate when a measurement window is live.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short",
          "decimals": 0,
          "mappings": [
            { "type": "value", "options": { "0": { "text": "IDLE", "color": "text" } } },
            { "type": "value", "options": { "1": { "text": "CAPTURING", "color": "green" } } }
          ]
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "monad_pi_wifi5g_capture_active{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Current dwell channel",
      "description": "Channel number the hop thread is currently dwelling on. 0 when no capture is active.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "blue", "value": 1 }
            ]
          },
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "monad_pi_wifi5g_current_channel{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total dwell transitions",
      "description": "Cumulative successful channel-hop transitions since agent start. A flat curve while capture_active=1 means the hop thread is stuck or the interface rejected channel changes.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "monad_pi_wifi5g_dwell_changes_total{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Dwell hop rate (last 1 min)",
      "description": "Channel hops per second averaged over the last minute. Expected: ~2 hops/s at 0.5 s dwell across 24 channels. 0 during idle or if hopping is stuck.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "green", "value": 0.5 }
            ]
          },
          "unit": "ops",
          "decimals": 2
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "rate(monad_pi_wifi5g_dwell_changes_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Capture window (active / idle)",
      "description": "1 = tcpdump running, 0 = idle. Useful as a shaded annotation layer when overlaying with power or BLE panels.",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 30,
            "gradientMode": "none",
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "short",
          "min": 0,
          "max": 1.1
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "monad_pi_wifi5g_capture_active{instance=~\"$instance\"}",
          "legendFormat": "capture_active {{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Current dwell channel over time",
      "description": "Which 5 GHz channel the hop thread is dwelling on. Flat = stuck; sawtooth = healthy channel rotation.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "short",
          "decimals": 0,
          "min": 0
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "monad_pi_wifi5g_current_channel{instance=~\"$instance\"}",
          "legendFormat": "channel {{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Channel-hop rate (hops/s)",
      "description": "rate(monad_pi_wifi5g_dwell_changes_total[1m]). Expected ~2 hops/s at 0.5 s dwell. A flat zero while capture is active indicates the iface rejected channel changes — likely because a managed parent iface is associated and controls the radio.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "ops",
          "decimals": 2,
          "min": 0
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "rate(monad_pi_wifi5g_dwell_changes_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "hop rate {{instance}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 38,
  "tags": ["monad", "wifi", "5ghz", "pi"],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Pi instance",
        "type": "query",
        "query": {
          "query": "label_values(monad_pi_wifi5g_capture_active, instance)",
          "refId": "MimirVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Monad Pi 5 GHz Wi-Fi Telemetry",
  "uid": "monad-pi-wifi5g-telemetry",
  "version": 1
}
