{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Per-Pi power telemetry sourced from the agent /metrics endpoint scraped by the Pi-side Prometheus and remote-written to Mimir. Includes Pi core voltage, CPU temp, under-voltage / throttling state, and (Pi 5 only) the PMIC 3V3_SYS rail used to approximate AX210 power on the official Raspberry Pi M.2 HAT+. See PR #18 for the metric definitions and the AX210 baseline-subtraction methodology.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Under-voltage right now",
      "description": "0 = supply healthy, 1 = vcgencmd reports an under-voltage condition. This is the authoritative signal that the new power supply is (in)adequate during AX210 scans.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UNDER-VOLTAGE",
                  "color": "red"
                }
              }
            }
          ]
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "monad_pi_under_voltage{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Throttled state (raw bitfield)",
      "description": "Raw vcgencmd get_throttled value. Bits: 0=under-voltage now, 1=freq capped now, 2=throttled now, 3=soft temp limit now, 16=under-voltage occurred, 17=freq capped occurred, 18=throttled occurred, 19=soft temp limit occurred.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 65536
              }
            ]
          },
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "monad_pi_throttled_state{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Approx AX210 power (current * voltage - baseline)",
      "description": "Approximate AX210 watts on the 3V3_SYS rail, computed as (current - baseline) * voltage. Set the dashboard variable pi_baseline_a once after running 60 s with rfkill block all and AX210 disabled. Accuracy ~+/- 10% during active scans.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1.0
              },
              {
                "color": "orange",
                "value": 1.5
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "targets": [
        {
          "expr": "(monad_pi_pmic_3v3_sys_current_amps{instance=~\"$instance\"} - $pi_baseline_a) * monad_pi_pmic_3v3_sys_voltage_volts{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "state-timeline",
      "title": "Under-voltage timeline",
      "description": "Per-Pi history of the under-voltage flag. Any red band during an AX210 scan means the supply dipped under threshold for that interval.",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UNDER-VOLTAGE",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.9,
        "mergeValues": true,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "monad_pi_under_voltage{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pi core voltage",
      "description": "vcgencmd measure_volts core. Pi 5 idle is typically ~0.75 V; rises slightly under load.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "monad_pi_voltage_volts{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU temperature",
      "description": "Pi CPU temp from /sys/class/thermal/thermal_zone0/temp. Throttling kicks in around 80 C without a heatsink.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "monad_pi_cpu_temp_celsius{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "PMIC 3V3_SYS current (Pi 5; M.2 + system 3.3 V)",
      "description": "Total current on the Pi 5 PMIC 3V3_SYS rail. On the official RPi M.2 HAT+, this rail feeds the M.2 slot directly. With no other 3.3 V loads on the Pi, this is dominated by AX210 + a small Pi baseline (typically 20-40 mA).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "amp",
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "monad_pi_pmic_3v3_sys_current_amps{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "PMIC 3V3_SYS voltage (Pi 5)",
      "description": "Voltage on the 3V3_SYS rail. Should sit near 3.30 V; sustained dips below ~3.20 V indicate supply or HAT regulation issues.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3.2
              },
              {
                "color": "green",
                "value": 3.25
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "monad_pi_pmic_3v3_sys_voltage_volts{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Approximate AX210 power (3V3_SYS rail minus Pi baseline)",
      "description": "Approximate AX210 watts derived from the 3V3_SYS rail. Set the pi_baseline_a variable to the mean PMIC 3V3_SYS current observed during a 60 s baseline run with the AX210 disabled (rfkill block all). Accuracy ~+/- 10% during active scans.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1.0
              },
              {
                "color": "orange",
                "value": 1.5
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "(monad_pi_pmic_3v3_sys_current_amps{instance=~\"$instance\"} - $pi_baseline_a) * monad_pi_pmic_3v3_sys_voltage_volts{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} (approx AX210)",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "monad",
    "pi",
    "power",
    "ax210"
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Pi instance",
        "type": "query",
        "query": {
          "query": "label_values(monad_pi_voltage_volts, instance)",
          "refId": "MimirVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pi_baseline_a",
        "label": "Pi 3V3_SYS baseline (A) for AX210 differential",
        "type": "constant",
        "description": "Mean PMIC 3V3_SYS current of the AX210-idle baseline (chip present + driver bound but radio interface DOWN). Default 0.084 A is the empirical monad-03 measurement (Pi 5 + official M.2 HAT+ + AX210 in standby). Override per-Pi at view time; for an absolute AX210 baseline (Pi-alone) characterize with `rfkill block all` after the radio interface is up.",
        "query": "0.084",
        "current": {
          "selected": false,
          "text": "0.084",
          "value": "0.084"
        }
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Monad Pi Power Telemetry",
  "uid": "monad-pi-power-telemetry",
  "version": 1,
  "weekStart": ""
}
